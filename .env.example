# Niche paths (DB, Instagram profile, category yaml) live in config/niches.yaml.
# street_food (default) and concert are both registered there.
NICHE=street_food
# hackathon | production  (re-check schedule + sub-genre thresholds)
MODE=hackathon
# Optional: load ANTHROPIC_API_KEY from another project's .env
# KEYS_ENV_FILE=/path/to/.env
ANTHROPIC_API_KEY=sk-ant-...
